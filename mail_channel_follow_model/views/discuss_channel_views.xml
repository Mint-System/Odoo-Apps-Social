<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="discuss_channel_view_form" model="ir.ui.view">
        <field name="name">mail_channel_follow_model.discuss_channel_view_form</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="follows" string="Follows">
                    <field
                        name="follower_ids"
                        context="{'default_channel_id': id}"
                        nolabel="1"
                    >
                        <list editable="bottom">
                            <field name="model_id" />
                            <field name="subtype_id" />
                            <field name="external_only" />
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
